rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'apriliazril67@gmail.com' ||
        request.auth.token.email == 'apriliansyahazril10@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Website Config: public read for features & maintenance check; write admin only
    match /settings/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Statistics: public read; create/update by admin or server
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activities: public read recent for live feed, write for logging anonymous sessions; admin full access
    match /activities/{activityId} {
      allow read: if true;
      allow create: if request.resource.data.sessionId is string &&
                       request.resource.data.sessionId.size() <= 64;
      allow update, delete: if isAdmin();
    }

    // Admins whitelist
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
